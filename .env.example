# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Platform & Storefront Wildcard Domains
VITE_PLATFORM_DOMAIN="suk.et"
VITE_STOREFRONT_DOMAIN="mystore.et"
NEXT_PUBLIC_PLATFORM_DOMAIN="suk.et"
NEXT_PUBLIC_STOREFRONT_DOMAIN="mystore.et"

# Supabase Credentials
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Supabase Storage Bucket Names
VITE_SUPABASE_STORAGE_PRODUCT_IMAGES="product-images"
VITE_SUPABASE_STORAGE_BUSINESS_ASSETS="business-assets"
VITE_SUPABASE_STORAGE_STOREFRONT_ASSETS="storefront-assets"
VITE_SUPABASE_STORAGE_AVATARS="avatars"
VITE_SUPABASE_STORAGE_DOCUMENTS="documents"
VITE_SUPABASE_STORAGE_APPEALS="appeals"
